DB_DSN=postgresql://user:password@localhost:5432/warehouse
# Read-only role used by the investigator tools (created by 0002_readonly_role.sql)
DB_READONLY_DSN=postgresql://mars_reader:changeme@localhost:5432/warehouse
REDIS_URL=redis://localhost:6379/0

# Active LLM + Embedder — OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Anthropic kept as fallback (set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage AI kept as fallback (set LLM_PROVIDER=voyage to use for embeddings)
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBEDDING_MODEL=voyage-3

# Investigator tool budget
INVESTIGATOR_MAX_TOOL_CALLS=10
INVESTIGATOR_MAX_ITERATIONS=5
INVESTIGATOR_TIMEOUT_SEC=30
