DB_DSN=postgresql://user:password@localhost:5432/warehouse
REDIS_URL=redis://localhost:6379/0

# LLM — Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings — Voyage AI (voyage-3, 1024 dims)
# Get a key at https://www.voyageai.com/
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# OpenAI (optional — only needed if switching embedding provider back to OpenAI)
OPENAI_API_KEY=sk-...
